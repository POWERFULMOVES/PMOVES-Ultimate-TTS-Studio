# PMOVES.AI Tier Environment: Media
# For Media processing services (Whisper, YOLO, FFmpeg, etc.)
# Source after env.shared: source env.shared && source env.tier-media.sh

# ============================================================================
# Media Tier Configuration
# ============================================================================

TIER=media

# Media processing limits
MAX_CONCURRENT_JOBS=${MAX_CONCURRENT_JOBS:-4}  # Limited for GPU
MAX_FILE_SIZE_MB=${MAX_FILE_SIZE_MB:-2000}
JOB_TIMEOUT_MS=${JOB_TIMEOUT_MS:-1800000}  # 30 minutes

# GPU configuration
GPU_ENABLED=${GPU_ENABLED:-true}
GPU_MEMORY_FRACTION=${GPU_MEMORY_FRACTION:-0.9}
GPU_ALLOW_GROWTH=${GPU_ALLOW_GROWTH:-true}
CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}

# Video processing
VIDEO_MAX_FRAMES=${VIDEO_MAX_FRAMES:-10000}
VIDEO_SAMPLE_RATE=${VIDEO_SAMPLE_RATE:-1}  # Sample every Nth frame
VIDEO_MAX_RESOLUTION=${VIDEO_MAX_RESOLUTION:-1080p}

# Audio processing
AUDIO_SAMPLE_RATE=${AUDIO_SAMPLE_RATE:-16000}
AUDIO_CHANNELS=${AUDIO_CHANNELS:-1}
AUDIO_MAX_DURATION_SECONDS=${AUDIO_MAX_DURATION_SECONDS:-3600}

# Image processing
IMAGE_MAX_SIZE=${IMAGE_MAX_SIZE:-4096}  # Max dimension
IMAGE_FORMAT=${IMAGE_FORMAT:-jpg}
IMAGE_QUALITY=${IMAGE_QUALITY:-90}

# Whisper transcription
WHISPER_MODEL=${WHISPER_MODEL:-small}
WHISPER_LANGUAGE=${WHISPER_LANGUAGE:-auto}
WHISPER_TASK=${WHISPER_TASK:-transcribe}

# YOLO object detection
YOLO_MODEL=${YOLO_MODEL:-yolov8m}
YOLO_CONFIDENCE_THRESHOLD=${YOLO_CONFIDENCE_THRESHOLD:-0.25}
YOLO_IOU_THRESHOLD=${YOLO_IOU_THRESHOLD:-0.45}

# FFmpeg configuration
FFMPEG_NUM_THREADS=${FFMPEG_NUM_THREADS:-4}
FFMPEG_PRESET=${FFMPEG_PRESET:-medium}
FFMPEG_CRF=${FFMPEG_CRF:-23}

# Output storage
OUTPUT_BUCKET=${OUTPUT_BUCKET:-outputs}
OUTPUT_FORMAT=${OUTPUT_FORMAT:-json}
INCLUDE_METADATA=${INCLUDE_METADATA:-true}
